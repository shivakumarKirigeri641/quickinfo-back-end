# ── Server ──
PORT=7788
# Comma-separated list of front-end origins allowed to call this API.
CORS_ORIGINS=http://localhost:5180,http://localhost:3000
# Must match VITE_SECRET_KEY in quickinfo-front-end (response encryption).
SECRET_KEY=

# ── PostgreSQL: the SAME database as serverpe-back-end ──
# Copy these five values from serverpe-back-end/.env.
PGHOST=
PGPORT=5432
PGDATABASEMAIN=
PGUSER=
PGPASSWORD=

# ── Branding added to every JSON response ──
PLATFORM_NAME=QuickInfo
POWERED_BY=ServerPe App Solutions
PUBLIC_WEBSITE=www.quickinfo.in

# ── Mail (same SMTP account as serverpe-back-end) ──
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
NOREPLYMAIL=
NOREPLYMAIL_PASSWORD=
MAIL_FROM_NAME=QuickInfo
ADMINMAIL=

# ── WhatsApp Cloud API (optional contact acknowledgement) ──
# Leave QUICKINFO_WA_ACK_ENABLED off until the template is approved by Meta.
QUICKINFO_WA_ACK_ENABLED=false
QUICKINFO_WA_ACK_TEMPLATE=live_contact_acknowledgement
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
